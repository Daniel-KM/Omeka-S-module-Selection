msgstr ""
"Ne dalv nemet pa vez gweredekaet ar muiañ-karet hag an dibaboù evit an "
"implijer, war ar bajenn /guest/selection."

#: src/Form/SiteSettingsFieldset.php:142
msgid "Hide (favorites only accessible via /guest/favorites)"
msgstr "Kuzhat (ne c'haller tizhout ar muiañ-karet nemet dre /guest/favorites)"

#: src/Form/SiteSettingsFieldset.php:143
msgid "Show at the top of the list"
msgstr "Diskouez e laez ar roll"

#: src/Form/SiteSettingsFieldset.php:144
msgid "Show as root in hierarchy disposition only"
msgstr "Diskouez evel gwrizienn en aozadur dre renk hepken"

#: src/Form/SiteSettingsFieldset.php:157
msgid "Allow users to share their own selections"
msgstr "Aotren an implijerien da rannañ o dibaboù dezho"

#: src/Form/SiteSettingsFieldset.php:159
msgid "Only admins can publish"
msgstr "N'eus nemet ar verourien a c'hall embann"

#: src/Form/SiteSettingsFieldset.php:160
