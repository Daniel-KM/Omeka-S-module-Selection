<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Omeka\Entity\User|null $user
 */

$plugins = $this->getHelperPluginManager();
$translate = $plugins->get('translate');
$escapeAttr = $plugins->get('escapeHtmlAttr');
$url = $plugins->get('url');

/** @var \Laminas\Session\Container $selectionContainer */
$selectionContainer = $plugins->get('selectionContainer')();
$selection = reset($selectionContainer->selections);
$selectionId = $selection ? $selection['id'] : 0;
$resourceId = $resource->id();
$selected = isset($selectionContainer->records[$selectionId][$resourceId]);

$urlSelection = $url('site/selection', [
    'site-slug' => $site->slug(),
    'action' => null,
], ['force_canonical' => false]);
?>
<button type="button"
    class="selection-favorite<?= $selected ? ' is-selected' : '' ?>"
    data-resource-id="<?= $resourceId ?>"
    data-url="<?= $escapeAttr($urlSelection) ?>"
    aria-pressed="<?= $selected ? 'true' : 'false' ?>"
    title="<?= $escapeAttr($translate('Add to my favorites')) // @translate ?>">
    <span class="selection-favorite-icon <?= $selected ? 'fas' : 'far' ?> fa-star" aria-hidden="true"></span>
    <span class="selection-favorite-label visually-hidden"><?= $translate('My favorites') // @translate ?></span>
</button>
