<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 * @var \Omeka\Entity\User $user
 * @var array $valueOptions
 * @var array $selecteds
 * @var string $mode
 * @var string $disposition
 * @var bool $isGuestActive
 * @var bool $isSession
 * @var string $urlSelections
 * @var string $urlSelection
 * @var string $messageSuccess
 * @var string $messageError
 * @var string $placeholder
 * @var bool $allowStoreNoGroup
 *
 * and options passed from the caller.
 */

// For multiple selections.

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$siteSetting = $plugins->get('siteSetting');
$escapeAttr = $plugins->get('escapeHtmlAttr');

if ($this->selectionMode() === 'none') {
    if (!$siteSetting('selection_hide_login')): ?>
        <?= $this->partial('common/guest-login', ['label' => $translate('Log in to add to selection')]) ?>
    <?php endif;
    return;
}

$openDetails = false;

$placeholder = $escapeAttr($placeholder ?? $translate('Choose a selection'));

// The value options may contain sub arrays.
?>

<details class="selection-groups" <?= $openDetails ? 'open="open"' : '' ?>>
    <summary><?= $escape($translate('Add to a selection')) ?></summary>
    <div id="selector-group" class="selector-group selection-mode-<?= $mode ?> inactive" data-resource-id="<?= $resource->id() ?>" data-url="<?= $urlSelection ?>" data-url-selections="<?= $urlSelections ?>">
        <select name="group" class="chosen-select"<?= in_array($mode, ['standard', 'nested'], true) ? ' multiple="multiple"' : '' ?> aria-label="<?= $placeholder ?>" placeholder="<?= $placeholder ?>" data-placeholder="<?= $placeholder ?>" data-message-success="<?= $escapeAttr($messageSuccess) ?>" data-message-error="<?= $escapeAttr($messageError) ?>" data-is-multiple-selection="1">
            <?php // Required for chosen. When there are multiple select, it cannot be without any select. ?>
            <option value=""></option>
            <?php foreach ($valueOptions as $key => $label): ?>
            <option value="<?= $key ?>"<?= in_array($key, $selecteds) ? ' selected="selected"' : '' ?>><?= $escape($label) ?></option>
            <?php endforeach ?>
            <option class="selection-action" data-action="add" value="00"><?= $translate('Create a new selection') ?></option>
        </select>
    </div>
</details>
