<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 * @var \Omeka\Entity\User $user
 * @var int $selectionId
 * @var array $selections
 * @var array $records
 * @var string $disposition
 * @var bool $isGuestActive
 * @var bool $isSession
 * @var string $value
 * @var string $action
 * @var string $urlButton
 *
 * and options passed from the caller.
 */

$plugins = $this->getHelperPluginManager();
$translate = $plugins->get('translate');
$siteSetting = $plugins->get('siteSetting');

if (!$user && $siteSetting('selection_disable_anonymous')) {
    if (!$siteSetting('selection_hide_login')): ?>
        <?= $this->partial('common/guest-login', ['label' => $translate('Log in to add to selection')]) ?>
    <?php endif;
    return;
}

$escapeAttr = $plugins->get('escapeHtmlAttr');

$textSelect['unselected'] = $translate('Add to selection');
$textSelect['selected'] = $translate('Remove from selection');
$textSelect['add'] = $textSelect['unselected'];
$textSelect['delete'] = $textSelect['selected'];
$class = $value === 'selected' ? 'selected' : 'unselected';
$text = in_array($action, ['add', 'delete']) ? $textSelect[$action] : $textSelect[$class];
?>

<button type="button" class="button selection-button selection-update <?= $class ?> selection-<?= $escapeAttr($action) ?>" data-id="<?= $resource->id() ?>" title="<?= $text ?>" data-action="<?= $escapeAttr($action) ?>" data-text-selected="<?= $textSelect['selected'] ?>" data-text-unselected="<?= $textSelect['unselected'] ?>" data-url="<?= $urlButton ?>">
    <span class="selection-icon"></span>
</button>
