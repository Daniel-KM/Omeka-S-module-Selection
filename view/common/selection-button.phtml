<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 * @var \Omeka\Entity\User $user
 * @var int $selectionId
 * @var array $selections
 * @var array $records
 * @var string $disposition
 * @var bool $isGuestActive
 * @var bool $isSession
 * @var string $value
 * @var string $action
 * @var string $urlButton
 * @var int $maxResources
 * @var int $currentCount
 *
 * and options passed from the caller.
 */

$plugins = $this->getHelperPluginManager();
$translate = $plugins->get('translate');
$siteSetting = $plugins->get('siteSetting');

$mode = $this->selectionMode();

if ($mode === 'none') {
    if (!$siteSetting('selection_hide_login')): ?>
        <?= $this->partial('common/guest-login', ['label' => $translate('Log in to add to selection')]) ?>
    <?php endif;
    return;
}

if ($mode === 'simple') {
    echo $this->partial('common/selection-button-simple', [
        'resource' => $resource,
        'site' => $site,
        'user' => $user,
    ]);
    return;
}

$escapeAttr = $plugins->get('escapeHtmlAttr');

$textSelect['unselected'] = $translate('Add to selection');
$textSelect['selected'] = $translate('Remove from selection');
$textSelect['include'] = $textSelect['unselected'];
$textSelect['exclude'] = $textSelect['selected'];
$class = $value === 'selected' ? 'selected' : 'unselected';
$text = in_array($action, ['include', 'exclude']) ? $textSelect[$action] : $textSelect[$class];
?>

<button type="button" class="button selection-button selection-update <?= $class ?> selection-<?= $escapeAttr($action) ?>" data-id="<?= $resource->id() ?>" title="<?= $text ?>" data-action="<?= $escapeAttr($action) ?>" data-text-selected="<?= $textSelect['selected'] ?>" data-text-unselected="<?= $textSelect['unselected'] ?>" data-url="<?= $urlButton ?>" data-max-resources="<?= $maxResources ?? 50 ?>" data-current-count="<?= $currentCount ?? 0 ?>">
    <span class="selection-icon"></span>
</button>
