<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Omeka\Entity\User $user
 * @var \Selection\Api\Representation\SelectionRepresentation|null $selection
 * @var \Selection\Api\Representation\SelectionRepresentation|null $resource
 * @var int $selectionId
 * @var array $selections
 * @var array $records
 * @var bool $isGuestActive
 * @var bool $isSession
 * @var string $mode
 * @var string $disposition
 * @var bool $allowIndividualSelect
 */

// Flat list of resources of a selection.

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$api = $plugins->get('api');
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$thumbnail = $plugins->get('thumbnail');
$escapeAttr = $plugins->get('escapeHtmlAttr');
$translatePlural = $plugins->get('translatePlural');
$selectionReset = $plugins->get('selectionReset');
$selectionButtonToSelect = $plugins->get('selectionButtonToSelect');
$bulkExport = $plugins->has('bulkExport') ? $plugins->get('bulkExport') : null;
$contactUs = $plugins->has('contactUs') ? $plugins->get('contactUs') : null;

if (isset($selection) && is_object($selection)) {
    $selectionId = $selection->id();
    $selectionRecords = $plugins->get('selectionRecords');
    $records = $selectionRecords($selection);
} else {
    $selection = $selections[$selectionId];
}
$currentRecords = $records[$selectionId] ?? [];

// Honor the order stored in selection.structure[/].resources if available.
$structureOrder = is_object($selection)
    ? ($selection->structure()['/']['resources'] ?? null)
    : ($selections[$selectionId]['structure']['/']['resources'] ?? null);
if ($structureOrder && $currentRecords) {
    $sorted = [];
    foreach ($structureOrder as $rid) {
        $rid = (int) $rid;
        if (isset($currentRecords[$rid])) {
            $sorted[$rid] = $currentRecords[$rid];
            unset($currentRecords[$rid]);
        }
    }
    $currentRecords = $sorted + $currentRecords;
}

$recordsByType = array_column($currentRecords, 'resource_name', 'id');
$countsByType = array_count_values($recordsByType) + ['items' => 0, 'media' => 0, 'item_sets' => 0, 'annotations' => 0];

$selectText = $escapeAttr($translate('Select resource'));
$deleteText = $escapeAttr($translate('Remove from selection'));

$baseUrl = $url('site/selection-id', ['id' => $selectionId ?: '0', 'action' => ''], true);

// TODO Get the resources one time via api (currently only needed for thumbnail, not prepared early).
// $resources = $selectedRecords ? $api->search('items', ['id' => array_keys($selectedRecords)])->getContent() : [];
?>

<div class="selection-list selections selection-flat">

    <?php if (count($currentRecords)): ?>
    <div class="selection-count">
        <?= sprintf($translatePlural('%s resource', '%s resources', count($currentRecords)), count($currentRecords)) ?>
    </div>
    <?php //= $selection instanceof \Selection\Api\Representation\SelectionRepresentation ? $selectionReset($selection) : '' ?>
    <?php else: ?>
    <p class="selection-empty">
        <?= $translate('The selection is empty.') ?>
    </p>
    <?php endif; ?>

    <?php $this->trigger('view.browse.before'); ?>

    <ul class="resource-list selection-sortable"
        data-selection-id="<?= (int) $selectionId ?>"
        data-group="/"
        data-url-reorder="<?= $escapeAttr($url('site/selection', ['site-slug' => $site->slug(), 'action' => 'reorder'])) ?>">
        <?php foreach ($currentRecords as $resourceId => $record):
            try {
                $resource = $record['resource'] ?? $api->read($record['resource_name'], ['id' => $resourceId])->getContent();
            } catch (Exception $e) {
                continue;
            }
            $resourceId = $record['id'];
            $resourceType = $record['type'];
            $heading = $record['heading'];
            $body = $record['body'];
            $linkContent = sprintf('%s<span class="resource-name">%s</span>', $thumbnail($resource, 'medium'), $escape($heading));
            ?>
        <li class="selection-resource resource <?= $resourceType ?>" data-id="<?= $resourceId ?>">
            <?php if ($allowIndividualSelect): ?>
            <input type="checkbox" name="resource_ids[]" class="selected-resource" value="<?= $resourceId ?>" aria-label="<?= $selectText ?>"/>
            <?php endif; ?>
            <?= $hyperlink->raw($linkContent, $record['url'], ['class' => 'resource-link']) ?>
            <?php if ($body): ?>
            <div class="description">
                <?= $escape($body) ?>
            </div>
            <?php endif; ?>
            <ul class="actions">
                <?php if ($mode === 'simple'): ?>
                <li><button type="button" class="delete selection-button selection-exclude" data-id="<?= $record['id'] ?>" data-url="<?= "$baseUrl/exclude?id=$resourceId" ?>"><?= $deleteText ?></button></li>
                <?php else: ?>
                <li><?= $selectionButtonToSelect($resource) ?>
                <?php endif; ?>
            </ul>
        </li>
        <?php endforeach; ?>
    </ul>

    <?php $this->trigger('view.browse.after'); ?>

    <?php
    if ($currentRecords && $bulkExport) { // Does not support mixed types for now.
        echo '<h4>' . $translate('Select resources and download metadata') . '</h4>';
        $recordsByType = array_column($currentRecords, 'type', 'id');
        $countsByType = array_count_values($recordsByType);
        if (count($countsByType) === 1) {
            echo $bulkExport(array_keys($currentRecords), ['resourceType' => key($countsByType)]);
        } else {
            foreach (array_keys($countsByType) as $type) {
                echo $bulkExport(array_keys($currentRecords, $type), ['resourceType' => $type]);
            }
        }
    }
    ?>

    <?= $currentRecords && $contactUs ? $contactUs([
        'html' => '<h4>' . $translate('Select resources and send an email') . '</h4>',
    ]) : '' ?>

</div>
