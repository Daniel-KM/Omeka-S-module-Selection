<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Selection\Api\Representation\SelectionRepresentation[] $selections
 * @var \Selection\Api\Representation\SelectionRepresentation[] $resources
 * @var \Omeka\Entity\User $user
 * @var bool $isGuestActive
 * @var bool $isSession
 * @var string $mode
 * @var string $disposition
 * @var bool $allowIndividualSelect
 */

// Browse the list of selections (of the current user for guest).

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$partial = $plugins->get('partial');
$escape = $plugins->get('escapeHtml');
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$pageTitle = $plugins->get('pageTitle');
$siteSetting = $plugins->get('siteSetting');
$translatePlural = $plugins->get('translatePlural');
$guestNavigation = $user && $plugins->has('guestNavigation') ? $plugins->get('guestNavigation')() : null;
$breadcrumbs = $plugins->has('breadcrumbs') ? $plugins->get('breadcrumbs') : null;

$vars = $this->vars();
$hasGuestNav = $guestNavigation && $guestNavigation->getContainer()->count();

// May be included in main layout.
$this->headLink()
    ->appendStylesheet($assetUrl('css/common-dialog.css', 'Common'))
    ->appendStylesheet($assetUrl('css/selection.css', 'Selection'));
$this->headScript()
    ->appendFile($assetUrl('js/common-dialog.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/selection.js', 'Selection'), 'text/javascript', ['defer' => 'defer']);

$this->htmlElement('body')->appendAttribute('class', 'selection resource browse');

$siteSlug = $site->slug();
$bulkExporters = null;
?>

<?php if ($breadcrumbs && !$hasGuestNav): ?>
<?= $breadcrumbs() ?>
<?php endif; ?>

<?php if ($hasGuestNav): ?>
<nav class="navigation-guest">
    <?= $guestNavigation->menu()->renderMenu() ?>
</nav>
<?php endif; ?>

<?= $pageTitle($siteSetting('selection_label', $translate('Selections')), 2) ?>

<?php if ($this->userIsAllowed(\Selection\Entity\Selection::class, 'create')): ?>
<div class="selection-list-actions">
    <ul class="actions">
        <li>
            <button type="button" class="button add" data-msg-selection-name="<?= $translate('Set title of the new selection') ?>" data-url="<?= $url('site/selection', ['action' => 'add'], true) ?>"><?= $translate('Create a new selection') ?></button>
        </li>
    </ul>
</div>
<?php endif; ?>

<?php if ($isSession): ?>
<?php $labelWarning = $siteSetting('selection_warning_anonymous', $translate('This selection is stored in the session cookie. It will be lost if the cookie is cleared.')); ?>
<p class="selection-warning-anonymous">
    <strong><?= $translate('Warning') ?></strong>
    <?= $escape($labelWarning) ?>
</p>
<?php endif; ?>

<?php //= $this->searchFiltersSelection() // TODO search filters selections ?>

<div class="browse-controls">
    <?= $p = $this->pagination() ?>
    <?= $this->browse()->renderSortSelector('selections') ?>
</div>

<?php $this->trigger('view.browse.before'); ?>

<ul class="resource-list selection-list">
    <?php
    $vars->offsetSet('records', null);
    $msgs = [];
    $msgs['visible'] = $translate('Visible to the public');
    $msgs['invisible'] = $translate('Invisible to the public');
    $msgs['publish'] = $translate('Publish');
    $msgs['unpublish'] = $translate('Unpublish');
    $msgs['publish-confirm'] = $translate('Do you want to make this selection visible to the public?');
    $msgs['unpublish-confirm'] = $translate('Do you want to make this selection invisible to the public?');
    foreach ($selections as $selection):
        $heading = $selection->label();
        $resourceCount = $selection->resourceCount();
        $total = sprintf($translatePlural('%d resource', '%d resources', $resourceCount), $resourceCount);
        $isPublic = $selection->isPublic();
        $visibility = $isPublic ? $msgs['visible'] : $msgs['invisible'];
        $baseUrl = $selection->siteUrl($siteSlug);
        $vars->offsetSet('selection', $selection);
        ?>
    <li class="selection resource selection-<?= $isPublic ? 'public' : 'private' ?>" data-id="<?= $selection->id() ?>">
        <?php
        $linkContent = sprintf('%s<span class="resource-name">%s</span>',
            $selection->thumbnail('medium'),
            $escape($heading));
        echo $selection->linkRaw($linkContent, null, ['class' => 'resource-link']);
        ?>
        <div class="description total-resources"><?= $escape($total) ?></div>
        <div class="description visibility <?= $isPublic ? 'visibility-public' : 'visibility-private' ?>" data-msg-visible="<?= $msgs['visible'] ?>" data-msg-invisible="<?= $msgs['invisible'] ?>"><?= $escape($visibility) ?></div>
       <details class="action-details">
            <summary class="selection-summary group-name" aria-expanded="false"><?= $translate('Actions') ?></summary>
            <ul class="actions">
                <?php // TODO Fixme Add actions for grouped and hierarchy. ?>
                <?php if ($selection->userIsAllowed('update')): ?>
                <li><button type="button" class="button rename" data-url="<?= $baseUrl ?>/edit" data-msg="<?= $translate('Set the new name of the selection') ?>"><?= $escape($translate('Rename')) ?></button></li>
                <li><button type="button" class="button <?= $isPublic ? 'unpublish' : 'publish' ?>" data-url="<?= $baseUrl  ?>/edit" data-msg-publish="<?= $msgs['publish'] ?>" data-msg-unpublish="<?= $msgs['unpublish'] ?>" data-msg-publish-confirm="<?= $msgs['publish-confirm'] ?>" data-msg-unpublish-confirm="<?= $msgs['unpublish-confirm'] ?>"><?= $escape($isPublic ? $msgs['unpublish'] : $msgs['publish']) ?></button></li>
                <?php endif; ?>
                <?php if ($bulkExporters): ?>
                <li><button type="button" class="button export" data-url="<?= $baseUrl ?>/export"><?= $escape($translate('Export resources')) ?></button>
                    <ul>
                        <?php
                        foreach ($bulkExporters as $format => $label):
                            $urlFormat = $url('site/resource/output', ['site-slug' => $siteSlug, 'controller' => 'resource', 'action' => 'browse', 'format' => $format], ['id' => array_keys($selection->resources())]);
                            ?>
                        <li><a class="download-file download-id" href="<?= $urlFormat ?>" download="download" target="_self"><button type="button" class="export-group download-<?= $format ?>" data-url="<?= $urlFormat ?>"><?= $escape($label) ?></button></a></li>
                        <?php endforeach; ?>
                    </ul>
                <?php endif; ?>
                </li>
                <?php if ($selection->userIsAllowed('delete')): ?>
                <li><button type="button" class="button delete selection-delete" data-url="<?= $baseUrl ?>/delete" data-msg="<?= $translate('Delete this selection') ?>"><?= $escape($translate('Delete selection')) ?></button></li>
                <?php endif; ?>
            </ul>
        </details>

        <?= $partial('selection/site/selection/list-' . $disposition) ?>

    </li>
    <?php endforeach; ?>
</ul>

<?php $this->trigger('view.browse.after'); ?>

<?= $p ?>
