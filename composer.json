{
    "name": "daniel-km/omeka-s-module-selection",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Allow any visitor to store selected resources or search queries through sessions and to export them to common formats.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "personal library",
        "user board",
        "favorites",
        "search history"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Selection",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Selection/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2412)": {
        "omeka/omeka-s": "^4.1",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "Selection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SelectionTest\\": "tests/SelectionTest/"
        }
    },
    "extra": {
        "installer-name": "Selection"
    }
}
